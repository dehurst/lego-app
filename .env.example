# Copy this file to .env.local and fill in the values.
# In production, add the same variables in Vercel → Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Safe to expose to the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server-only. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Used for quiet hours (9pm–7am) and display times.
APP_TIMEZONE=America/New_York

# --- Added in later milestones ---
# M2: Web Push (generate with: npx web-push generate-vapid-keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# M4: Brickset (https://brickset.com/tools/webservices/requestkey)
# BRICKSET_API_KEY=
# M5: protects the hourly check endpoint
# CRON_SECRET=
