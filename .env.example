# Copy this file to .env.local and fill in the values.
# In production, add the same variables in Vercel → Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Safe to expose to the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server-only. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Used for quiet hours (9pm–7am) and display times.
APP_TIMEZONE=America/New_York

# --- Web Push (M2) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SECRET.
VAPID_PRIVATE_KEY=
# Contact address push services can use if there's a problem.
VAPID_SUBJECT=mailto:you@example.com
# SECRET. One-time "invite code" for creating the FIRST admin account.
# Once an admin exists it stops working; you can then delete it.
ADMIN_SECRET=

# --- LEGO catalog (M4) ---
# SECRET. rebrickable.com → Account → Settings → API → Generate new key
REBRICKABLE_API_KEY=

# --- Hourly check (M5) ---
# SECRET. Supabase's scheduler sends this so only it can trigger the check.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Brickset (optional): launch dates, prices, "now in stores" alerts ---
# SECRET. https://brickset.com/tools/webservices/requestkey
# Without it the app still works; sets just have no availability info.
BRICKSET_API_KEY=
